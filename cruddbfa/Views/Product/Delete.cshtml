@model cruddbfa.Models.Product

@{
    ViewData["Title"] = "Delete Product";
}

<h1>Delete Product</h1>

<h3>Are you sure you want to delete this product?</h3>

<hr />

<dl class="row">

    <dt class="col-sm-3">
        Product Name
    </dt>

    <dd class="col-sm-9">
        @Model.ProductName
    </dd>


    <dt class="col-sm-3">
        Category
    </dt>

    <dd class="col-sm-9">
        @Model.Category
    </dd>


    <dt class="col-sm-3">
        Price
    </dt>

    <dd class="col-sm-9">
        @Model.Price
    </dd>


    <dt class="col-sm-3">
        Stock Quantity
    </dt>

    <dd class="col-sm-9">
        @Model.StockQuantity
    </dd>

</dl>

<form asp-action="Delete" method="post">

    <input type="hidden" asp-for="Id" />

    <button type="submit"
            class="btn btn-danger">
        Delete
    </button>

    <a asp-action="Index"
       class="btn btn-secondary">
        Cancel
    </a>

</form>